[Unit]
Description=KorFinNews Daily Financial News Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
EnvironmentFile=-/etc/claude-token.env
WorkingDirectory=/home/opc/kor_fin_news
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/opc/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/opc"
ExecStart=/usr/bin/python3 /home/opc/kor_fin_news/main.py
Restart=on-failure
RestartSec=300
TimeoutStopSec=60

StandardOutput=append:/home/opc/kor_fin_news/logs/stdout.log
StandardError=append:/home/opc/kor_fin_news/logs/stderr.log
SyslogIdentifier=kor_fin_news

[Install]
WantedBy=multi-user.target
